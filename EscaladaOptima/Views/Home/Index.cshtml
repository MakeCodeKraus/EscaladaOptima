@{
    ViewData["Title"] = "Escalada Óptima";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/styles.css">
</head>

<body>
    <div class="container mt-5">
        <h1 class="text-center">Escalada Óptima</h1>
        <div class="row mt-4">
            <div class="col-md-6">
                <h3>Requisitos</h3>
                <div class="mb-3">
                    <label for="minCalorias" class="form-label">Mínimo de calorías:</label>
                    <input type="number" class="form-control" id="minCalorias" value="15">
                </div>
                <div class="mb-3">
                    <label for="maxPeso" class="form-label">Peso máximo:</label>
                    <input type="number" class="form-control" id="maxPeso" value="10">
                </div>
            </div>
            <div class="col-md-6">
                <h3>Elementos disponibles</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Peso</th>
                            <th>Calorías</th>
                        </tr>
                    </thead>
                    <tbody id="elementosTable">
                        <!-- Los elementos se agregarán dinámicamente aquí -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col text-center">
                <button class="btn btn-primary" onclick="calcularCombinacionOptima()">Calcular Combinación
                    Óptima</button>
            </div>
        </div>
        <div class="row mt-4" id="combinacionOptimaContainer" style="display: none;">
            <div class="col">
                <h3>Combinación óptima:</h3>
                <ul id="combinacionOptima" class="list-group">
                    <!-- La combinación óptima se mostrará aquí -->
                </ul>
            </div>
        </div>

    </div>

    <!-- Bootstrap JS y dependencias -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Nuestro script -->
    <script src="~/js/script.js"></script>
</body>

</html>